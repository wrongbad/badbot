#!/usr/bin/env bash
# akern: an agent kernel in one bash script. docs/story.md builds it up piece by piece.
#
# One pipe, the bus, that everyone writes lines to. One loop that reads it and
# hands every line to every actor, each on a pipe of its own. An actor is a
# function in the background: it reads lines, keeps a little state, puts lines.
#
#   stdin ─> input ──┐                    ┌──> writer ──> stdout, session file
#            inbox ──┤                    ├──> inbox    when the model is asked
#            model ──┼──> BUS ──> bus() ──┼──> model    asking it
#            tools ──┘                    └──> tools    doing what it asks
#
# Every line is one JSON object whose first key is "type", so a glob on the
# start of a line routes it. Lines: docs/lines.md.

((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 404)) || { echo "akern: needs bash 4.4 or later" >&2; exit 2; }
set -u
here=$(cd "$(dirname "$0")" && pwd)

usage() { echo "usage: akern [-s session.jsonl] [-m provider/model] [-S system.md] [prompt...]" >&2; exit 2; }
session= model=${AKERN_MODEL:-echo} system=
while getopts s:m:S: o; do
    case $o in
        s) session=$OPTARG ;;
        m) model=$OPTARG ;;
        S) system=$(<"$OPTARG") || exit 2 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
tmp=${TMPDIR:-/tmp}
: "${session:=$(mktemp "${tmp%/}/akern-session-XXXXXX")}"
touch "$session" && mkdir -p "$session.d/calls" || exit 2

# ── pipes ─────────────────────────────────────────────────────────────────────

# pipe NAME: an anonymous pipe in fd $NAME, open for reading and writing. The
# fifo is unlinked at once: nothing to clean up, nothing anyone else can open.
fds=()
pipe() {
    local f=$session.d/fifo.$$
    mkfifo "$f" && eval "exec {$1}<>\"\$f\"" && rm "$f" && fds+=("${!1}")
}

# bare CMD...: runs CMD without the kernel's pipes (in place of this process).
bare() {
    local fd
    for fd in "${fds[@]}"; do eval "exec $fd>&-"; done
    exec "$@"
}

# say LINE: puts one line on the bus. LOCK is a pipe holding one byte: whoever
# reads it may write, then puts it back. So a line goes onto the bus whole,
# however long it is and however many actors talk at once.
say() {
    local _
    read -rn1 -u "$LOCK" _
    printf '%s\n' "$1" >&"$BUS"
    printf . >&"$LOCK"
}

# put JQ [JQ-ARGS...]: says the line a jq expression builds.
put() { say "$(jq -nc "${@:2}" "$1")"; }

join() { local IFS=,; echo "$*"; }

DELTA='^\{"type":"[a-z_]+_delta"'          # display only: never stored, never routed
CALL='^\{"type":"[a-z_]+","call":"([^"]+)"' # a line about one tool call

# ── bus ───────────────────────────────────────────────────────────────────────

# Reads the bus and hands each line to every actor, in one order for all. The
# writer gets everything; the deltas go no further.
bus() {
    local line fd
    while IFS= read -r -u "$BUS" line; do
        printf '%s\n' "$line" >&"$TO_WRITER"
        [[ $line =~ $DELTA ]] && continue
        for fd in "$TO_INBOX" "$TO_MODEL" "$TO_TOOLS"; do
            printf '%s\n' "$line" >&"$fd"
        done
        [[ $line == '{"type":"exit"'* ]] && return
    done
}

# ── writer ────────────────────────────────────────────────────────────────────

# Chapter 0's tee, as an actor: every line to stdout, all but deltas to the file.
writer() {
    local line log
    exec {log}>>"$session"
    while IFS= read -r line; do
        printf '%s\n' "$line"
        [[ $line =~ $DELTA ]] || printf '%s\n' "$line" >&"$log"
        [[ $line == '{"type":"exit"'* ]] && return
    done
}

# ── input ─────────────────────────────────────────────────────────────────────

# stdin to the bus: plain text is a send, a line starting with { is a command.
input() {
    local line
    (($#)) && put '{type:"send",content:$c}' --arg c "$*"
    while IFS= read -r line || [[ $line ]]; do
        case $line in
            '') ;;
            '{'*) line=$(jq -c '{type} + .' <<<"$line" 2>/dev/null) && say "$line" ||
                put '{type:"error",where:"command",message:"invalid JSON"}' ;;
            *) put '{type:"send",content:$c}' --arg c "$line" ;;
        esac
    done
    say '{"type":"eof"}'
}

# ── inbox ─────────────────────────────────────────────────────────────────────

# The sequencer. Holds what waits to enter the conversation (sends, and jobs'
# late results) and the turn's tool results, and decides when they go in: all
# that is due as one user message, whenever the model is not talking. Opens
# and closes runs. Says exit once stdin has ended and nothing is left.
inbox() {
    local line id when blocks run open= busy= abort= stop= eof= settled=1
    local -a queue=() calls=()
    local -A pending=() results=() jobs=()
    run=$(grep -c '^{"type":"run_start"' "$session")
    while IFS= read -r line; do
        case $line in
            '{"type":"send"'*)
                { read -r when; read -r blocks; } < <(jq -r '(.when // "turn"),
                    ([.content | if type == "string" then [{type:"text",text:.}] else . end
                      | .[] | tojson] | join(","))' <<<"$line")
                queue+=("$blocks")
                put '{type:"queued",when:$w,n:$n}' --arg w "$when" --argjson n "${#queue[@]}"
                [[ $when == now && $busy ]] && say '{"type":"preempt"}' ;;
            '{"type":"abort"'*)
                ((${#queue[@]})) && say "{\"type\":\"returned\",\"content\":[$(join "${queue[@]}")]}"
                queue=()
                [[ $open ]] && abort=1 ;;
            '{"type":"message","source":"assistant"'*)
                while IFS= read -r id; do calls+=("$id") pending[$id]=1; done < <(
                    jq -r '.message.content[] | select(.type == "tool_use") | .id' <<<"$line") ;;
            '{"type":"turn_end"'*)
                busy=
                [[ $line =~ \"stop\":\"([a-z_]+)\" ]] && stop=${BASH_REMATCH[1]} ;;
            '{"type":"job"'*)
                [[ $line =~ $CALL ]] && id=${BASH_REMATCH[1]} || continue
                [[ ${pending[$id]-} ]] && { unset 'pending[$id]'; jobs[$id]=1; } ;;
            '{"type":"block"'*)
                [[ $line =~ $CALL ]] && id=${BASH_REMATCH[1]} || continue
                blocks=$(jq -c .block <<<"$line")
                if [[ ${pending[$id]-} ]]; then
                    unset 'pending[$id]'; results[$id]=$blocks
                elif [[ ${jobs[$id]-} ]]; then
                    unset 'jobs[$id]'; queue+=("$blocks") # a job's late result wakes the model
                fi ;;
            '{"type":"eof"'*) eof=1 ;;
            '{"type":"exit"'*) return ;;
            *) continue ;;
        esac
        deliver
    done
}

# What is due goes in as one user message, or the run ends. Runs after every
# line the inbox cares about; reads and sets inbox()'s variables.
deliver() {
    [[ $busy ]] && return # the model is talking: everything waits for its turn_end
    if ((${#pending[@]})); then
        [[ ${#queue[@]} -gt 0 && ! $abort ]] || return # wait for the calls
        for id in "${!pending[@]}"; do                 # a message never waits for a call:
            jobs[$id]=1                                # the calls still running go on as jobs
            put '{type:"job",call:$id}' --arg id "$id"
        done
        pending=()
    fi
    local content=() source=results
    for id in "${calls[@]}"; do # the answers first, in call order
        [[ ${results[$id]-} ]] && content+=("${results[$id]}")
    done
    calls=() results=()
    if [[ ! $abort ]] && ((${#queue[@]})); then
        ((${#content[@]})) && source=results+inbox || source=inbox
        content+=("${queue[@]}") queue=()
    fi
    if ((${#content[@]})); then
        [[ $open ]] || { open=1 settled=; ((run++)); say "{\"type\":\"run_start\",\"run\":$run}"; }
        say "{\"type\":\"message\",\"source\":\"$source\",\"run\":$run,\"message\":{\"role\":\"user\",\"content\":[$(join "${content[@]}")]}}"
        stop=
        [[ $abort ]] || { busy=1; return; } # the model answers it
    elif [[ $open && ! $abort && $stop == tool_use ]]; then
        busy=1 stop= # every call went on as a job: the model goes on at once
        say '{"type":"continue"}'
        return
    fi
    if [[ $open ]]; then
        local reason=done
        [[ $stop == error ]] && reason=error
        [[ $abort ]] && reason=aborted
        say "{\"type\":\"run_end\",\"run\":$run,\"reason\":\"$reason\"}"
        open= abort= stop=
        ((${#queue[@]})) && { deliver; return; } # sent after an abort: a new run
    fi
    ((${#jobs[@]})) && return
    [[ $settled ]] || { settled=1; say '{"type":"settled"}'; }
    [[ $eof == 1 ]] && { eof=2; say '{"type":"exit"}'; }
}

# ── model ─────────────────────────────────────────────────────────────────────

# Asks the model: a turn starts when a user message goes in (or on continue),
# and runs the provider in the background, so the actor keeps listening and
# can stop it. Keeps the context: every message line it has seen.
model() {
    local line run=0 turn=0 pid= aborted= from ctx=$session.d/context.jsonl
    jq -c 'select(.type == "message") | .message' "$session" >"$ctx" # resuming: the file is the state
    while IFS= read -r line; do
        case $line in
            '{"type":"run_start"'*)
                [[ $line =~ \"run\":([0-9]+) ]] && run=${BASH_REMATCH[1]} turn=0 aborted= ;;
            '{"type":"message"'*)
                jq -c .message <<<"$line" >>"$ctx"
                [[ $line == '{"type":"message","source":"assistant"'* || $aborted ]] || start_turn ;;
            '{"type":"continue"'*) start_turn ;;
            '{"type":"preempt"'*) stop_provider ;;
            '{"type":"abort"'*) aborted=1; stop_provider ;;
            '{"type":"turn_end"'*) pid= ;;
            '{"type":"exit"'*) stop_provider; return ;;
        esac
    done
}

find_provider() {
    local dir home=${AKERN_HOME:-$HOME/.akern}
    for dir in "$here/providers" "$home/providers" "$home/system/providers"; do
        [[ -x $dir/$1 ]] && { echo "$dir/$1"; return; }
    done
    return 1
}

start_turn() {
    local provider request=$session.d/request.json name=${model#*/}
    [[ $model == */* ]] || name=
    ((turn++))
    put '{type:"turn_start",run:$r,turn:$t}' --argjson r "$run" --argjson t "$turn"
    if ! provider=$(find_provider "${model%%/*}"); then
        put '{type:"error",where:"provider",message:"no provider for \($m)"}' --arg m "$model"
        put '{type:"turn_end",run:$r,turn:$t,stop:"error"}' --argjson r "$run" --argjson t "$turn"
        return
    fi
    jq -sc --arg model "$name" --arg session "$session" --arg system "$system" \
        --slurpfile tools "$here/tools.json" '{model:$model, session:$session,
        system:(if $system == "" then null else $system end), messages:.,
        tools:($tools[0] | map(del(.program))), params:{}}' "$ctx" >"$request"
    exec {from}< <(bare "$provider" <"$request")
    pid=$!
    relay <&"$from" &
    exec {from}<&-
}

# SIGTERM asks the provider for a result with what it has so far; SIGKILL if not.
stop_provider() {
    [[ $pid ]] || return 0
    kill -TERM "$pid" 2>/dev/null
    { sleep 2 && kill -KILL "$pid"; } 2>/dev/null &
}

# Worker: the provider's lines onto the bus, then its result as the turn's
# assistant message and turn_end. Only a tool_use stop keeps its calls.
relay() {
    local line result=
    while IFS= read -r line; do
        case $line in
            '{"type":"result"'*) result=$line ;;
            '{'*) say "$line" ;;
        esac
    done
    if [[ ! $result ]]; then
        put '{type:"error",where:"provider",message:"provider exited without a result"}'
        result='{"stop":"error","message":{"content":[]}}'
    fi
    jq -c --argjson run "$run" --argjson turn "$turn" '
        if .stop != "tool_use" then .message.content |= map(select(.type != "tool_use")) else . end
        | (select(.message.content | length > 0)
           | {type:"message", source:"assistant", run:$run, turn:$turn, message}),
          {type:"turn_end", run:$run, turn:$turn, stop, usage}' <<<"$result" |
        while IFS= read -r line; do say "$line"; done
}

# ── tools ─────────────────────────────────────────────────────────────────────

# Runs every tool call an assistant message asks for, each in the background,
# and kills them on abort (jobs too only with "jobs":true) and at exit.
tools() {
    local line id call
    local -A running=() jobs=()
    while IFS= read -r line; do
        case $line in
            '{"type":"message","source":"assistant"'*)
                while IFS= read -r call; do
                    put '{type:"tool_start",call:$c.id,name:$c.name,input:$c.input}' --argjson c "$call"
                    run_call "$call" &
                    running[$(jq -r .id <<<"$call")]=$!
                done < <(jq -c '.message.content[] | select(.type == "tool_use")' <<<"$line") ;;
            '{"type":"job"'*) [[ $line =~ $CALL ]] && jobs[${BASH_REMATCH[1]}]=1 ;;
            '{"type":"block"'*) [[ $line =~ $CALL ]] && unset "running[${BASH_REMATCH[1]}]" ;;
            '{"type":"abort"'*)
                for id in "${!running[@]}"; do
                    [[ ${jobs[$id]-} && $line != *'"jobs":true'* ]] || kill_call "$id"
                done ;;
            '{"type":"exit"'*)
                for id in "${!running[@]}"; do kill_call "$id"; done
                return ;;
        esac
    done
}

# A call's files: $c.out (stdout and stderr), $c.pid, $c.status, and $c.killed,
# which kill_call leaves in case the call has not started yet: whichever of the
# two comes second does the killing.
kill_call() {
    local c=$session.d/calls/$1
    touch "$c.killed"
    [[ -s $c.pid ]] && kill -TERM -- "-$(<"$c.pid")" 2>/dev/null
}

# Worker: one call, after its tool_start, to its block. The command runs in a process
# group of its own (set -m), so killing the call kills everything it started.
# Past its wait, a timer says it goes on as a job.
run_call() {
    local id name cmd wait c status timer limit=100000 start=$SECONDS
    { read -r id; read -r name; read -r wait; } < <(jq -r '.id, .name, (.input.wait // "")' <<<"$1")
    cmd=$(jq -r '.input.command // ""' <<<"$1")
    c=$session.d/calls/$id
    if [[ $name != shell ]]; then
        echo "no tool named $name" >"$c.out" && status="not run"
    else
        if [[ $wait ]]; then
            { sleep "$wait" & wait $!; [[ -e $c.status ]] || put '{type:"job",call:$id}' --arg id "$id"; } &
            timer=$!
        fi
        {
            set -m
            bare bash -c "$cmd" >"$c.out" 2>&1 </dev/null &
            echo $! >"$c.pid"
            [[ -e $c.killed ]] && kill -TERM -- "-$!"
            wait $!
        } 2>/dev/null
        status=$?
        ((status > 128)) && status="signal $((status - 128))" || status="exit $status"
        echo "$status" >"$c.status"
        [[ ${timer-} ]] && pkill -P "$timer" sleep # the timer's sleep, never the timer: it may hold LOCK
    fi
    local size head="[$status]"
    size=$(wc -c <"$c.out")
    ((size > limit)) && head="[$status; cut at $limit of $((size)) bytes, all of it in $c.out]" # $((…)): wc pads
    say "$(head -c "$limit" "$c.out" | jq -Rsc --arg id "$id" --arg name "$name" --arg h "$head" \
        --arg st "$status" --argjson ran $((SECONDS - start)) '{type:"block", call:$id,
        block:{type:"tool_result", tool_use_id:$id, is_error:false,
               content:[{type:"text", text:($h + "\n" + .)}], name:$name, status:$st, ran:$ran}}')"
}

# ── main ──────────────────────────────────────────────────────────────────────

pipe BUS
pipe LOCK && printf . >&"$LOCK"
pipe TO_WRITER && pipe TO_INBOX && pipe TO_MODEL && pipe TO_TOOLS

writer <&"$TO_WRITER" &
writer_pid=$!
inbox <&"$TO_INBOX" >/dev/null &
model <&"$TO_MODEL" >/dev/null &
tools <&"$TO_TOOLS" >/dev/null &
put '{type:"hello",session:$s,model:$m}' --arg s "$session" --arg m "$model"
input "$@" <&0 >/dev/null &
input_pid=$!
bus &
bus_pid=$!

# Ctrl-C aborts the run; a second within 3 seconds, or SIGTERM, exits. Every
# background child ignores SIGINT, so only this shell hears it.
last_int=-9
on_int() {
    ((SECONDS - last_int < 3)) && say '{"type":"exit"}' || say '{"type":"abort"}'
    last_int=$SECONDS
}
trap on_int INT
trap 'say "{\"type\":\"exit\"}"' TERM HUP

while kill -0 "$bus_pid" 2>/dev/null; do wait "$bus_pid"; done
kill "$input_pid" 2>/dev/null
wait "$writer_pid"

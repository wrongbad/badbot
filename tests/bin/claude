#!/usr/bin/env python3
"""Stands in for the claude CLI in stream-json mode, as the claude-code provider drives it.

Logs to $FAKE_CLAUDE_LOG, one JSON line per record: {"start": argv, "env": ...} when it starts,
{"in": line} for each stdin line, {"mcp": [request, response]} for each MCP exchange it starts.
At start it asks the SDK-hosted badbot server for its tool list, as claude does. It acknowledges
each user line sent with shouldQuery false with a result line, as claude does. A user line
that comes while calls wait for their results, it takes in with them, as claude does.

$FAKE_CLAUDE_REPLY holds a JSON array of replies, used in order across every start (the next index
is kept in $FAKE_CLAUDE_REPLY.n). A reply is {"events": [stream events], "calls": [tool_use ids],
"result": {result line fields} or absent}: its events are printed as stream_event lines when a
queried user line arrives, or once every call of the previous reply has its tools/call answered;
then a tools/call per call id; then, without calls, the result line that ends claude's turn."""
import json
import os
import sys

LOG, REPLIES = os.environ["FAKE_CLAUDE_LOG"], os.environ["FAKE_CLAUDE_REPLY"]
requests_sent = 0
pending = {}  # request_id -> (kind, message)
waiting_calls = set()


def log(record):
    with open(LOG, "a") as f:
        f.write(json.dumps(record) + "\n")


def out(line):
    sys.stdout.write(json.dumps(line) + "\n")
    sys.stdout.flush()


def mcp(message, kind):
    global requests_sent
    requests_sent += 1
    rid = f"fake-{requests_sent}"
    pending[rid] = (kind, message)
    out({"type": "control_request", "request_id": rid,
         "request": {"subtype": "mcp_message", "server_name": "badbot", "message": message}})


def next_reply():
    counter = REPLIES + ".n"
    n = int(open(counter).read()) if os.path.exists(counter) else 0
    open(counter, "w").write(str(n + 1))
    replies = json.load(open(REPLIES))
    return replies[n] if n < len(replies) else {"events": [], "result": {"is_error": True, "result": "no reply left"}}


def reply():
    r = next_reply()
    for event in r.get("events", []):
        out({"type": "stream_event", "event": event, "parent_tool_use_id": None})
    for i, call_id in enumerate(r.get("calls", [])):
        waiting_calls.add(call_id)
        mcp({"jsonrpc": "2.0", "id": 100 + i, "method": "tools/call",
             "params": {"name": "exec", "arguments": {}, "_meta": {"claudecode/toolUseId": call_id}}}, "call")
    if not r.get("calls") and "result" in r:
        out({"type": "result", "subtype": "success", "is_error": False, **r["result"]})


log({"start": sys.argv[1:], "env": dict(os.environ)})
mcp({"jsonrpc": "2.0", "id": 1, "method": "tools/list"}, "list")
for raw in sys.stdin:
    line = json.loads(raw)
    log({"in": line})
    if line["type"] == "control_response":
        kind, message = pending.pop(line["response"]["request_id"])
        log({"mcp": [message, line["response"]]})
        if kind == "call":
            waiting_calls.discard(message["params"]["_meta"]["claudecode/toolUseId"])
            if not waiting_calls:
                reply()
    elif line["type"] == "control_request":
        out({"type": "control_response", "response": {"subtype": "success", "request_id": line["request_id"],
                                                       "response": {}}})
    elif line["type"] == "user" and line.get("shouldQuery") is False:
        out({"type": "result", "subtype": "success", "num_turns": 0, "is_error": False})
    elif line["type"] == "user" and waiting_calls:
        pass  # mid-turn, as claude does: taken in at its next step, with the calls' results
    elif line["type"] == "user":
        reply()
